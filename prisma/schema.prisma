// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("client")
  createdAt DateTime @default(now())
  complaints Complaint[]
  votes     Vote[]       // ← este es el nuevo campo que soluciona el error
}

model Complaint {
  id           String   @id @default(uuid())
  title        String
  description  String
  category     String
  subcategory  String
  imageUrl     String?   // URL o path de la imagen (opcional)
  location     String?   // Dirección, coordenadas o referencia (opcional)
  status       String    @default("open")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  authorId     String
  author       User      @relation(fields: [authorId], references: [id])
  userVotes    Vote[]   // ← esta relación activa el sistema de votos
  // 🔹 Relación con Entidad
  entityId     Int?
  entidad      Entidad?  @relation(fields: [entityId], references: [id])
}


model Entidad {
  id          Int          @id @default(autoincrement())
  nombre      String       @unique
  categorias  Categoria[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  complaints Complaint[] // relación inversa
}

model Categoria {
  id          Int          @id @default(autoincrement())
  nombre      String
  entidadId   Int
  entidad     Entidad      @relation(fields: [entidadId], references: [id])
  subcategorias SubCategoria[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  @@unique([nombre, entidadId])
}

model SubCategoria {
  id          Int        @id @default(autoincrement())
  nombre      String
  categoriaId Int
  categoria   Categoria  @relation(fields: [categoriaId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  @@unique([nombre, categoriaId])
}
model Vote {
  id          String    @id @default(uuid())
  userId      String
  complaintId String
  type        String    // 👈 positivo o negativo
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id])
  complaint   Complaint @relation(fields: [complaintId], references: [id])
}

model FAQ {
  id        String   @id @default(uuid())
  question  String
  answer    String
  category  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
